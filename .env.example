# OracleDB Data Lab — development configuration
# Copy to .env and adjust. Everything here is read on the server only.

# Key used to encrypt saved connection passwords at rest (AES-256-GCM).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# If empty, a key is generated once and stored in .data/lab/secret.key.
NUXT_LAB_SECRET=

# node-oracledb driver mode: thin (default, Oracle DB 12.1+) or thick (needed for 11g, requires Oracle Instant Client)
NUXT_ORACLE_DRIVER_MODE=thin
# Thick mode only: directory containing Oracle Instant Client libraries (Windows/macOS)
NUXT_ORACLE_CLIENT_LIB_DIR=
# Optional: directory containing tnsnames.ora / sqlnet.ora / wallet (TNS_ADMIN)
NUXT_ORACLE_CONFIG_DIR=

# Connection pool per saved profile
NUXT_ORACLE_POOL_MAX=8
NUXT_ORACLE_POOL_MIN=0
NUXT_ORACLE_POOL_TIMEOUT=60
# Round-trip timeout for a single database call (ms)
NUXT_ORACLE_CALL_TIMEOUT_MS=120000

# Safety limits
NUXT_LIMITS_MAX_CONCURRENCY=32
NUXT_LIMITS_HEAVY_CONCURRENCY_THRESHOLD=8
NUXT_LIMITS_MAX_BENCHMARK_SECONDS=1800
NUXT_LIMITS_MAX_BATCH_SIZE=20000
NUXT_LIMITS_MAX_ROWS=100000000
NUXT_LIMITS_MAX_CONCURRENT_JOBS=2
NUXT_LIMITS_MAX_EXTENSION_TABLES=300

# Integration tests (npm run test:integration) — point at a disposable test schema only.
ODL_TEST_CONNECT_STRING=
ODL_TEST_USER=
ODL_TEST_PASSWORD=
