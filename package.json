{
  "name": "oracledb-data-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Testing, benchmarking, synthetic data generation and observability platform for Oracle Database.",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "start": "node .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.149",
    "@nuxt/icon": "^2.6.2",
    "motion-v": "^2.9.0",
    "nuxt": "^4.6.3",
    "oracledb": "^26.0.0",
    "vue": "^3.5.44",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@types/node": "^22.20.5",
    "@types/oracledb": "^26.0.0",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
